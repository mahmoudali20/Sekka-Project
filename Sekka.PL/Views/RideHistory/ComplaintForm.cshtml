@model Sekka.BLL.ViewModels.ComplaintVM
@using Sekka.DAL.Models

@{
    bool isLostItem     = Model.Category == ComplaintCategory.LostItem;
    string pageTitle    = isLostItem ? "Report a Lost Item" : "File a Complaint";
    string submitLabel  = isLostItem ? "Submit Lost-Item Report" : "Submit Complaint";
    ViewData["Title"]   = pageTitle;

    var filteredCategories = Html.GetEnumSelectList<ComplaintCategory>()
        .Where(item => isLostItem
            ? item.Value == ((int)ComplaintCategory.LostItem).ToString()
            : item.Value != ((int)ComplaintCategory.LostItem).ToString())
        .ToList();
}

@section HeadLinks {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
}

<div class="sk-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="sk-page-header">
                    <a asp-controller="RideHistory" asp-action="Index"
                       class="d-inline-flex align-items-center gap-2 mb-3"
                       style="color:var(--sk-text-muted);font-size:.85rem;font-weight:500;text-decoration:none;">
                        <i class="bi bi-arrow-left" style="font-size:1rem;"></i> Back to Ride History
                    </a>

                    <div class="d-flex align-items-center gap-3 mb-1">
                        <div style="width:48px;height:48px;border-radius:50%;
                                    background:@(isLostItem ? "#FEF3C7" : "#FEE2E2");
                                    display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi @(isLostItem ? "bi-bag-x-fill" : "bi-flag-fill")"
                               style="font-size:1.3rem;color:@(isLostItem ? "#92400E" : "var(--sk-red)");"></i>
                        </div>
                        <div>
                            <h1 style="font-size:1.75rem;margin:0;">@pageTitle</h1>
                            @if (ViewBag.RideId is int rideId)
                            {
                                <p class="subtitle" style="margin:0;">
                                    Ride <code style="font-size:.85rem;background:var(--sk-surface-2);
                                               border:1px solid var(--sk-border);border-radius:4px;
                                               padding:1px 5px;">#@rideId</code>
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <a asp-controller="RideHistory"
                       asp-action="FileComplaint"
                       asp-route-rideId="@ViewBag.RideId"
                       asp-route-category="@((int)ComplaintCategory.DriverBehavior)"
                       class="btn @(isLostItem ? "btn-sk-outline-danger" : "btn-sk-danger")
                              d-inline-flex align-items-center gap-2">
                        <i class="bi bi-flag-fill"></i> Complaint
                    </a>
                    <a asp-controller="RideHistory"
                       asp-action="FileComplaint"
                       asp-route-rideId="@ViewBag.RideId"
                       asp-route-category="@((int)ComplaintCategory.LostItem)"
                       class="btn d-inline-flex align-items-center gap-2"
                       style="@(isLostItem
                           ? "background:var(--sk-amber);color:var(--sk-navy);border:none;font-weight:600;border-radius:var(--sk-radius-sm);padding:.65rem 1.5rem;font-size:.875rem;"
                           : "background:transparent;color:#92400E;border:1.5px solid #92400E;font-weight:600;border-radius:var(--sk-radius-sm);padding:.65rem 1.5rem;font-size:.875rem;")">
                        <i class="bi bi-bag-x-fill"></i> Lost Item
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="sk-alert sk-alert-danger"></div>

                <div class="sk-card mb-4">
                    <div class="sk-card-header navy">
                        <i class="bi @(isLostItem ? "bi-bag-x" : "bi-flag")"
                           style="color:var(--sk-amber);"></i>
                        @(isLostItem ? "Lost Item Details" : "Complaint Details")
                    </div>
                    <div class="sk-card-body">

                        <form asp-controller="RideHistory" asp-action="FileComplaint" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="TripId" />

                            <div class="sk-form-group">
                                <label asp-for="Category" class="sk-label">Category</label>
                                @if (isLostItem)
                                {
                                    <input type="hidden" asp-for="Category" />
                                    <input class="sk-input" style="background:var(--sk-surface-2);color:var(--sk-text-muted);cursor:default;"
                                           value="Lost Item" readonly />
                                }
                                else
                                {
                                    <select asp-for="Category"
                                            asp-items="filteredCategories"
                                            class="sk-input"></select>
                                }
                                <span asp-validation-for="Category" class="sk-field-error"></span>
                            </div>

                            @if (!isLostItem)
                            {
                                <div class="sk-form-group">
                                    <label asp-for="Priority" class="sk-label">Priority</label>
                                    <select asp-for="Priority"
                                            asp-items="Html.GetEnumSelectList<ComplaintPriority>()"
                                            class="sk-input"></select>
                                    <span asp-validation-for="Priority" class="sk-field-error"></span>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" asp-for="Priority" />
                            }

                            <div class="sk-form-group">
                                <label asp-for="Subject" class="sk-label">
                                    @(isLostItem ? "Item Description (brief)" : "Subject")
                                </label>
                                <input asp-for="Subject"
                                       class="sk-input"
                                       placeholder="@(isLostItem
                                           ? "e.g. Black backpack with laptop inside"
                                           : "e.g. Driver was rude and drove aggressively")" />
                                <span asp-validation-for="Subject" class="sk-field-error"></span>
                            </div>

                            <div class="sk-form-group">
                                <label asp-for="Description" class="sk-label">
                                    @(isLostItem ? "Details (where / when you last had it)" : "Full Description")
                                </label>
                                <textarea asp-for="Description"
                                          class="sk-input"
                                          rows="5"
                                          style="resize:vertical;"
                                          placeholder="@(isLostItem
                                              ? "Describe the item, approximate time you noticed it missing, and any other details that may help us locate it..."
                                              : "Please describe the incident in detail so our team can investigate...")"></textarea>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span asp-validation-for="Description" class="sk-field-error"></span>
                                    <small style="color:var(--sk-text-muted);font-size:.78rem;">Max 2000 characters</small>
                                </div>
                            </div>

                            @if (isLostItem)
                            {
                                <div class="sk-alert sk-alert-warning">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>
                                        We will contact you and the driver. Check your registered email for updates.
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="sk-alert sk-alert-info">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>
                                        Our support team reviews complaints within 24 hours and assigns them to an agent.
                                    </span>
                                </div>
                            }

                            <hr class="divider" />
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-controller="RideHistory" asp-action="Index"
                                   class="btn btn-sk-outline">Cancel</a>
                                <button type="submit"
                                        class="btn d-inline-flex align-items-center gap-2"
                                        style="@(isLostItem
                                            ? "background:var(--sk-amber);color:var(--sk-navy);border:none;font-weight:600;border-radius:var(--sk-radius-sm);padding:.65rem 1.5rem;font-size:.875rem;"
                                            : "background:var(--sk-red);color:#fff;border:none;font-weight:600;border-radius:var(--sk-radius-sm);padding:.65rem 1.5rem;font-size:.875rem;")">
                                    <i class="bi @(isLostItem ? "bi-send-check" : "bi-send")"></i>
                                    @submitLabel
                                </button>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
