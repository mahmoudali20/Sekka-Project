@model RegisterVM

@{
    ViewData["Title"] = "Create account";
}

<div class="sk-auth-wrap" style="align-items:flex-start;">
    <div class="container py-5">
        <div class="sk-auth-card" style="max-width:520px;">

            <div class="sk-auth-logo">
                Sekk<span class="accent">a</span>
            </div>

            <h2 class="text-center fw-700 mb-1" style="font-size:1.35rem;">Create your account</h2>
            <p class="text-center text-muted mb-4" style="font-size:.875rem;">Join thousands of riders across Egypt</p>

            <div asp-validation-summary="ModelOnly" class="sk-alert sk-alert-danger"></div>

            <form asp-action="Register" method="post">

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <div class="sk-form-group mb-0">
                            <label asp-for="FullName" class="sk-form-label">Full name</label>
                            <input asp-for="FullName" class="sk-form-control" placeholder="Ahmed Hassan" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="sk-form-group mb-0">
                            <label asp-for="UserName" class="sk-form-label">Username</label>
                            <input asp-for="UserName" class="sk-form-control" placeholder="ahmed_h" autocomplete="username" />
                            <span asp-validation-for="UserName" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>
                </div>

                <div class="sk-form-group mt-3">
                    <label asp-for="Email" class="sk-form-label">Email</label>
                    <input asp-for="Email" class="sk-form-control" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem;"></span>
                </div>

                <div class="sk-form-group">
                    <label asp-for="PhoneNumber" class="sk-form-label">Phone number</label>
                    <input asp-for="PhoneNumber" class="sk-form-control" placeholder="+20 1xx xxx xxxx" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:.8rem;"></span>
                </div>

                <div class="sk-form-group">
                    <label asp-for="Address" class="sk-form-label">Address</label>
                    <input asp-for="Address" class="sk-form-control" placeholder="e.g. Nasr City, Cairo" autocomplete="street-address" />
                    <span asp-validation-for="Address" class="text-danger" style="font-size:.8rem;"></span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <div class="sk-form-group mb-0">
                            <label asp-for="Password" class="sk-form-label">Password</label>
                            <input asp-for="Password" type="password" class="sk-form-control" placeholder="Min. 8 characters" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="sk-form-group mb-0">
                            <label asp-for="ConfirmPassword" class="sk-form-label">Confirm password</label>
                            <input asp-for="ConfirmPassword" type="password" class="sk-form-control" placeholder="Repeat password" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-sk-primary w-100 btn-lg mt-4">
                    Create account
                </button>

            </form>

            <p class="text-center mt-4 mb-0" style="font-size:.875rem;color:var(--sk-text-muted);">
                Already have an account?
                <a asp-action="Login" class="fw-600 text-amber" style="text-decoration:none;">Sign in</a>
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
