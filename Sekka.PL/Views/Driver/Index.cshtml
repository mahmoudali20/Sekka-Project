@model IEnumerable<DriverVM>

@{
    ViewData["Title"] = "Drivers";
}




@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="text-primary">Drivers</h2>

            <p class="text-muted mb-0">
                Manage all registered drivers
            </p>
        </div>

        <a asp-controller="Driver"
               asp-action="Create"
               class="btn btn-primary">

            <i class="bi bi-plus-circle me-2"></i>
            Add Driver

        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No drivers found.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var driver in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                      
                        <div class="text-center p-3">

                            @if (string.IsNullOrWhiteSpace(driver.ProfilePicture))
                            {
                                <img src="~/images/User.png.jpg"
                                     alt="Default Avatar"
                                     class="rounded-circle"
                                     style="width: 200px;
                                height: 200px;
                                object-fit: cover;" />
                            }
                            else
                            {
                                <img src="@Url.Action("Picture", "Driver", new { id = driver.Id })"
                                     alt="@driver.FullName"
                                     class="rounded-circle"
                                     style="width: 200px;
                                height: 200px;
                                object-fit: cover;" />
                            }

                        </div>


                        <div class="card-body text-center">

                            <h5 class="card-title text-primary">
                                @driver.FullName
                            </h5>

                        </div>



                        <div class="card-footer bg-white border-0 d-flex gap-2">

                            <a asp-controller="Driver"
                                   asp-action="Details"
                                   asp-route-id="@driver.Id"
                                   class="btn btn-outline-primary flex-fill">

                                Details

                            </a>

                            <a asp-controller="Driver"
                                   asp-action="Edit"
                                   asp-route-id="@driver.Id"
                                   class="btn btn-outline-secondary flex-fill">

                                Edit

                            </a>
                            <a asp-controller="Driver"
                                   asp-action="Delete"
                                   asp-route-id="@driver.Id"
                                   class="btn btn-outline-secondary flex-fill">

                                Delete

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<script>
    setTimeout(() => {
        document.getElementById("Alert")?.remove();
    }, 3000);
</script>