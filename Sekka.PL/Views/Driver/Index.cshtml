@model IEnumerable<DriverVM>

@{
    ViewData["Title"] = "Drivers";
}

<div class="sk-page">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="sk-flash" class="sk-alert sk-alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }
        else if (TempData["ErrorMessage"] != null)
        {
            <div id="sk-flash" class="sk-alert sk-alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="sk-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 style="font-size:1.75rem;">Drivers</h1>
                <p class="subtitle">
                    @{
                        var driverCount = Model?.Count() ?? 0;
                    }
                    @driverCount registered driver@(driverCount == 1 ? "" : "s") on the platform
                </p>
            </div>
            <a asp-controller="Driver" asp-action="Create"
               class="btn btn-sk-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Add Driver
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="sk-card">
                <div class="sk-empty">
                    <span class="icon"><i class="bi bi-car-front-fill"></i></span>
                    <h6 style="font-weight:700;color:var(--sk-text);">No drivers registered</h6>
                    <p>Add the first driver to start accepting ride requests.</p>
                    <a asp-controller="Driver" asp-action="Create" class="btn btn-sk-primary">
                        <i class="bi bi-plus-circle me-1"></i> Add Driver
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var driver in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="sk-card sk-ride-card" style="border-left:none;transition:transform .2s,box-shadow .2s;">

                            <div style="height:180px;overflow:hidden;position:relative;border-radius:var(--sk-radius) var(--sk-radius) 0 0;background:var(--sk-navy-3);">
                                @if (string.IsNullOrWhiteSpace(driver.ProfilePicture))
                                {
                                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                                        <div style="width:80px;height:80px;border-radius:50%;background:rgba(245,166,35,.15);display:flex;align-items:center;justify-content:center;font-size:2rem;color:var(--sk-amber);">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <img src="@Url.Action("Picture", "Driver", new { id = driver.Id })"
                                         alt="@driver.FullName"
                                         style="width:100%;height:100%;object-fit:cover;" />
                                }
                                <span style="position:absolute;top:.75rem;right:.75rem;background:var(--sk-green);color:#fff;font-size:.72rem;font-weight:700;padding:.25rem .6rem;border-radius:50px;">
                                    Active
                                </span>
                            </div>

                            <div class="sk-card-body">
                                <h6 style="font-family:var(--font-display);font-weight:700;font-size:1rem;margin-bottom:.2rem;color:var(--sk-navy);">
                                    @driver.FullName
                                </h6>
                                <p style="font-size:.8rem;color:var(--sk-text-muted);margin:0;">Driver</p>
                            </div>

                            <div class="sk-card-footer d-flex gap-2" style="background:var(--sk-surface);">
                                <a asp-controller="Driver" asp-action="Details" asp-route-id="@driver.Id"
                                   class="btn btn-sk-navy flex-fill btn-sm d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-controller="Driver" asp-action="Edit" asp-route-id="@driver.Id"
                                   class="btn btn-sk-outline flex-fill btn-sm d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-controller="Driver" asp-action="Delete" asp-route-id="@driver.Id"
                                   class="btn btn-sk-danger btn-sm d-inline-flex align-items-center justify-content-center gap-1"
                                   style="padding:.4rem .7rem;">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

<script>
    setTimeout(() => {
        const el = document.getElementById('sk-flash');
        if (el) {
            el.style.transition = 'opacity .3s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 300);
        }
    }, 3500);

    // subtle lift on hover
    document.querySelectorAll('.sk-card').forEach(c => {
        c.addEventListener('mouseenter', () => c.style.transform = 'translateY(-3px)');
        c.addEventListener('mouseleave', () => c.style.transform = '');
    });
</script>
