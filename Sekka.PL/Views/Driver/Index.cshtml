@model IEnumerable<DriverVM>

@{
    ViewData["Title"] = "Drivers";
    var driverCount    = Model?.Count() ?? 0;
    var availableCount = Model?.Count(d => d.IsAvailable) ?? 0;
    var offlineCount   = driverCount - availableCount;
    var avgRating      = driverCount > 0 ? Model.Average(d => d.RatingAverage) : 0;
}

<div class="sk-page">

    <!-- ── Full-bleed navy header ── -->
    <div class="sk-index-header">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div id="sk-flash" class="sk-alert sk-alert-success mb-3">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            else if (TempData["ErrorMessage"] != null)
            {
                <div id="sk-flash" class="sk-alert sk-alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <div class="sk-topbar">
                <div>
                    <h1 class="sk-page-title">Drivers</h1>
                    <p class="sk-page-sub">
                        @driverCount registered driver@(driverCount == 1 ? "" : "s") on the platform
                    </p>
                </div>
                <a asp-controller="Driver" asp-action="Create"
                   class="btn btn-sk-add d-inline-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Add driver
                </a>
            </div>

            <!-- Stat strip -->
            <div class="sk-stat-strip">
                <div class="sk-stat-item">
                    <div class="sk-stat-num">@driverCount</div>
                    <div class="sk-stat-lbl">Total</div>
                </div>
                <div class="sk-stat-item">
                    <div class="sk-stat-num sk-stat-green">@availableCount</div>
                    <div class="sk-stat-lbl">Available</div>
                </div>
                <div class="sk-stat-item">
                    <div class="sk-stat-num" style="color:rgba(255,255,255,.55);">@offlineCount</div>
                    <div class="sk-stat-lbl">Offline</div>
                </div>
                <div class="sk-stat-item">
                    <div class="sk-stat-num sk-stat-amber">
                        <i class="bi bi-star-fill" style="font-size:.9rem; vertical-align:middle;"></i>
                        @avgRating.ToString("0.0")
                    </div>
                    <div class="sk-stat-lbl">Avg rating</div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── Body ── -->
    <div class="container sk-index-body">

        @if (Model == null || !Model.Any())
        {
            <div class="sk-card">
                <div class="sk-empty">
                    <div class="sk-empty-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <h6 class="sk-empty-title">No drivers yet</h6>
                    <p class="sk-empty-body">Add the first driver to start accepting ride requests.</p>
                    <a asp-controller="Driver" asp-action="Create" class="btn btn-sk-primary">
                        <i class="bi bi-plus-lg me-1"></i> Add driver
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Toolbar -->
            <div class="sk-toolbar mb-4">
                <div class="sk-search-wrap">
                    <i class="bi bi-search sk-search-icon"></i>
                    <input type="text"
                           id="driverSearch"
                           class="sk-search-input"
                           placeholder="Search by name…"
                           autocomplete="off" />
                </div>

                <!-- Filter pills -->
                <div class="d-flex gap-2 align-items-center">
                    <button class="sk-filter-pill active" data-filter="all">All</button>
                    <button class="sk-filter-pill" data-filter="available">
                        <span class="pulse-dot" style="width:6px;height:6px;margin-right:4px;"></span>Available
                    </button>
                    <button class="sk-filter-pill" data-filter="offline">Offline</button>
                </div>

                <div class="sk-toolbar-meta">
                    <span id="driverCount" class="sk-count-pill">@driverCount drivers</span>
                </div>
            </div>

            <!-- Grid -->
            <div class="row g-3" id="driverGrid">
                @foreach (var driver in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4 sk-driver-col"
                         data-name="@driver.FullName.ToLower()"
                         data-status="@(driver.IsAvailable ? "available" : "offline")">

                        <div class="sk-card sk-driver-card h-100 d-flex flex-column">

                            <!-- Banner with photo / initials -->
                            <div class="sk-driver-banner" style="height:96px;">
                                @if (string.IsNullOrWhiteSpace(driver.ProfilePicture))
                                {
                                    <div class="sk-driver-avatar-lg">
                                        @{
                                            var initials = string.Join("", driver.FullName
                                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                .Take(2)
                                                .Select(w => w[0]));
                                        }
                                        @initials
                                    </div>
                                }
                                else
                                {
                                    <img src="@Url.Action("Picture", "Driver", new { id = driver.Id })"
                                         alt="@driver.FullName"
                                         class="sk-driver-photo" />
                                }

                                @if (driver.IsAvailable)
                                {
                                    <span class="sk-driver-status sk-driver-status--online">
                                        <span class="pulse-dot"></span> Available
                                    </span>
                                }
                                else
                                {
                                    <span class="sk-driver-status sk-driver-status--offline">
                                        <i class="bi bi-moon-fill" style="font-size:.6rem;"></i> Offline
                                    </span>
                                }
                            </div>

                            <!-- Info -->
                            <div class="sk-card-body sk-driver-info flex-grow-1">
                                <p class="sk-driver-name mb-0">@driver.FullName</p>
                                <p class="sk-driver-role mt-1 mb-2">
                                    <i class="bi bi-star-fill sk-star"></i>
                                    @driver.RatingAverage.ToString("0.0")
                                    <span class="sk-dot-sep">·</span>
                                    Driver
                                </p>
                                
                            </div>

                            <!-- Actions -->
                            <div class="sk-driver-actions">
                                <a asp-controller="Driver" asp-action="Details" asp-route-id="@driver.Id"
                                   class="btn btn-sk-navy btn-sm flex-fill d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-controller="Driver" asp-action="Edit" asp-route-id="@driver.Id"
                                   class="btn btn-sk-outline btn-sm flex-fill d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-controller="Driver" asp-action="Delete" asp-route-id="@driver.Id"
                                   class="btn btn-sk-danger btn-sm sk-icon-btn d-inline-flex align-items-center justify-content-center"
                                   title="Delete driver">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>

            <!-- No-results state -->
            <div id="noResults" class="sk-card mt-3" style="display:none;">
                <div class="sk-empty">
                    <div class="sk-empty-icon"><i class="bi bi-search"></i></div>
                    <h6 class="sk-empty-title">No drivers found</h6>
                    <p class="sk-empty-body">Try a different name or reset the filter.</p>
                </div>
            </div>
        }

    </div>
</div>

<style>
    .sk-filter-pill {
        display: inline-flex;
        align-items: center;
        padding: .35rem .85rem;
        border-radius: 50px;
        font-size: .78rem;
        font-weight: 600;
        border: 1px solid var(--sk-border);
        background: var(--sk-surface);
        color: var(--sk-text-muted);
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
    }
    .sk-filter-pill:hover    { border-color: var(--sk-border-2); color: var(--sk-text); }
    .sk-filter-pill.active   { background: var(--sk-navy); color: #fff; border-color: var(--sk-navy); }
</style>

<script>
    // Auto-dismiss flash alert
    setTimeout(() => {
        const el = document.getElementById('sk-flash');
        if (el) {
            el.style.transition = 'opacity .3s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 300);
        }
    }, 3500);

    const searchInput  = document.getElementById('driverSearch');
    const filterBtns   = document.querySelectorAll('.sk-filter-pill');
    const cols         = document.querySelectorAll('.sk-driver-col');
    const countEl      = document.getElementById('driverCount');
    const noRes        = document.getElementById('noResults');
    const grid         = document.getElementById('driverGrid');
    let   activeFilter = 'all';

    function applyFilters() {
        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        let visible = 0;
        cols.forEach(col => {
            const nameMatch   = col.dataset.name.includes(q);
            const statusMatch = activeFilter === 'all' || col.dataset.status === activeFilter;
            const show = nameMatch && statusMatch;
            col.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        if (countEl) countEl.textContent = visible + ' driver' + (visible === 1 ? '' : 's');
        const empty = visible === 0;
        if (noRes)  noRes.style.display  = empty ? '' : 'none';
        if (grid)   grid.style.display   = empty ? 'none' : '';
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeFilter = btn.dataset.filter;
            applyFilters();
        });
    });
</script>
