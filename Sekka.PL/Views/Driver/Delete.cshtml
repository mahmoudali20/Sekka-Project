<div class="sk-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="sk-card" style="border-top:4px solid var(--sk-red);">

                    <div class="sk-card-body text-center" style="padding:2.5rem 2rem 1.5rem;">

                        <div style="width:64px;height:64px;border-radius:50%;background:#FEE2E2;
                                    display:flex;align-items:center;justify-content:center;
                                    margin:0 auto 1.25rem;">
                            <i class="bi bi-trash3-fill" style="color:var(--sk-red);font-size:1.6rem;"></i>
                        </div>

                        <h2 style="font-family:var(--font-display);font-size:1.45rem;
                                   font-weight:800;color:var(--sk-navy);margin-bottom:.5rem;">
                            Delete this driver?
                        </h2>
                        <p style="color:var(--sk-text-muted);font-size:.9rem;max-width:320px;margin:0 auto 1.5rem;">
                            This action is permanent. All driver records, trips, and linked
                            data will be removed and cannot be recovered.
                        </p>

                        <div class="sk-alert sk-alert-danger" style="text-align:left;">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                            <span>Active trips linked to this driver may also be affected.</span>
                        </div>

                    </div>

                    <div class="sk-card-footer d-flex gap-3"
                         style="padding:1.25rem 2rem;background:var(--sk-surface-2);">
                        <a asp-controller="Driver" asp-action="Index"
                           class="btn btn-sk-outline flex-fill text-center">
                            No, keep driver
                        </a>
                        <form asp-action="Delete" method="post" class="flex-fill">
                            <button type="submit"
                                    class="btn btn-sk-danger w-100 d-inline-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-trash3"></i> Yes, delete
                            </button>
                        </form>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
