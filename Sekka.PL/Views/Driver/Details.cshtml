@model DriverDetailsVM

@{
    ViewData["Title"] = "Driver Details";
}

<div class="sk-page">
    <div class="container">

        <div class="sk-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="mb-2">
                    <a asp-controller="Driver" asp-action="Index"
                       style="background:var(--sk-surface);border:1px solid var(--sk-border);color:var(--sk-text-muted);padding:.4rem .9rem;border-radius:var(--sk-radius-sm);font-size:.85rem;text-decoration:none;display:inline-flex;align-items:center;gap:.4rem;">
                        <i class="bi bi-arrow-left"></i> All Drivers
                    </a>
                </div>
                <h1 style="font-size:1.75rem;">Driver Profile</h1>
                <p class="subtitle">Personal and vehicle information for @Model.FullName</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Driver" asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-sk-outline d-inline-flex align-items-center gap-2">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-controller="Driver" asp-action="Delete" asp-route-id="@Model.Id"
                   class="btn btn-sk-danger d-inline-flex align-items-center gap-2">
                    <i class="bi bi-trash3"></i> Delete
                </a>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-6">
                <div class="sk-card h-100">
                    <div class="sk-card-header navy">
                        <i class="bi bi-person-circle text-amber"></i>
                        Driver Information
                    </div>
                    <div class="sk-card-body">

                        <div class="text-center mb-4">
                            @if (string.IsNullOrWhiteSpace(Model.ProfilePicture))
                            {
                                <div style="width:110px;height:110px;border-radius:50%;background:var(--sk-navy-3);display:flex;align-items:center;justify-content:center;font-size:2.8rem;color:var(--sk-amber);margin:0 auto;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            }
                            else
                            {
                                <img src="@Url.Action("Picture", "Driver", new { id = Model.Id })"
                                     alt="@Model.FullName"
                                     style="width:110px;height:110px;border-radius:50%;object-fit:cover;border:3px solid var(--sk-amber);" />
                            }
                            <h5 style="font-family:var(--font-display);font-weight:800;margin-top:1rem;margin-bottom:.15rem;">@Model.FullName</h5>
                            <span style="font-size:.8rem;color:var(--sk-text-muted);">Driver</span>
                        </div>

                        <hr class="divider" />

                        <dl style="display:grid;grid-template-columns:1fr 1.5fr;gap:.6rem 1rem;font-size:.875rem;">
                            <dt style="color:var(--sk-text-muted);font-weight:500;">Email</dt>
                            <dd style="margin:0;font-weight:500;">@Model.Email</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">Phone</dt>
                            <dd style="margin:0;font-weight:500;">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">Address</dt>
                            <dd style="margin:0;font-weight:500;">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">License No.</dt>
                            <dd style="margin:0;font-weight:500;font-family:monospace;">@Model.LicenseNumber</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">Rating</dt>
                            <dd style="margin:0;">
                                <span style="color:var(--sk-amber);font-weight:700;">★</span>
                                <span style="font-weight:600;">@Model.RatingAverage.ToString("0.0")</span>
                            </dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">Availability</dt>
                            <dd style="margin:0;">
                                @if (Model.IsAvailable)
                                {
                                    <span style="background:#D1FAE5;color:#065F46;padding:.2rem .6rem;border-radius:50px;font-size:.78rem;font-weight:700;">
                                        <span class="sk-active-ride" style="border:none;background:none;box-shadow:none;display:inline;">
                                            <span class="pulse-dot" style="width:7px;height:7px;"></span>
                                        </span>
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span style="background:#F3F4F6;color:#6B7280;padding:.2rem .6rem;border-radius:50px;font-size:.78rem;font-weight:700;">Offline</span>
                                }
                            </dd>
                        </dl>

                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="sk-card h-100">
                    <div class="sk-card-header amber">
                        <i class="bi bi-car-front-fill"></i>
                        Vehicle Details
                    </div>
                    <div class="sk-card-body">

                        <div style="border-radius:var(--sk-radius);overflow:hidden;height:190px;background:var(--sk-surface-2);margin-bottom:1.25rem;">
                            @if (string.IsNullOrWhiteSpace(Model.CarImage))
                            {
                                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem;color:var(--sk-text-muted);">
                                    <i class="bi bi-image" style="font-size:2rem;opacity:.4;"></i>
                                    <span style="font-size:.8rem;">No photo uploaded</span>
                                </div>
                            }
                            else
                            {
                                <img src="@Url.Action("CarPicture", "Driver", new { id = Model.Id })"
                                     alt="@Model.CarModel"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                        </div>

                        <dl style="display:grid;grid-template-columns:1fr 1.5fr;gap:.6rem 1rem;font-size:.875rem;">
                            <dt style="color:var(--sk-text-muted);font-weight:500;">Model</dt>
                            <dd style="margin:0;font-weight:600;">@Model.CarModel</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">Color</dt>
                            <dd style="margin:0;font-weight:500;">@Model.CarColor</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">Plate No.</dt>
                            <dd style="margin:0;font-family:monospace;font-weight:600;letter-spacing:.5px;">@Model.PlateNumber</dd>

                            <dt style="color:var(--sk-text-muted);font-weight:500;">License Plate</dt>
                            <dd style="margin:0;font-family:monospace;font-weight:600;">@Model.LicensePlate</dd>
                        </dl>

                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
