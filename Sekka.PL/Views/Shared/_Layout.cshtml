<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sekka.PL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sekka.PL.styles.css" asp-append-version="true" />
    @* Per-page head links (e.g. Bootstrap Icons CDN from child views) *@
    @await RenderSectionAsync("HeadLinks", required: false)
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sekka.PL</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                     

                        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Passenger") || User.IsInRole("Driver"))  )
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold text-primary"
                                   asp-area="" asp-controller="Trips" asp-action="Index">Trips Dashboard</a>
                            </li>

                            @if (User.IsInRole("Passenger"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold"
                                       asp-area="" asp-controller="Trips" asp-action="Book">Book Ride</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold"
                                       asp-controller="RideHistory" asp-action="Index">Ride History</a>
                                </li>
                            }
                        }

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Driver" asp-action="Index">All Drivers</a>
                            </li>
                            @* {{!-- Admin: view only their own assigned tickets --}} *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Complaints" asp-action="MyTickets">My Tickets</a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">Manage Admins</a>
                            </li>
                            @* {{!-- SuperAdmin: see all complaints and assign them to admins --}} *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Complaints" asp-action="Index">All Complaints</a>
                            </li>
                        }
                    </ul>

