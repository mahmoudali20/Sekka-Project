<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Sekka</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/sekka.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sekka.PL.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("HeadLinks", required: false)
</head>

<body>

    <nav class="sk-navbar navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                Sekka<span class="brand-accent">.</span>
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#skNav"
                    aria-controls="skNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-white fs-4"></i>
            </button>

            <div class="collapse navbar-collapse" id="skNav">

                <ul class="navbar-nav me-auto gap-1">

                    @if (User.Identity?.IsAuthenticated == true &&
                         (User.IsInRole("Passenger") || User.IsInRole("Driver")))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Trips" asp-action="Index">
                                <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                            </a>
                        </li>

                        @if (User.IsInRole("Passenger"))
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-nav-cta ms-1" asp-controller="Trips" asp-action="Book">
                                    <i class="bi bi-plus-circle me-1"></i>Book Ride
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="RideHistory" asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i>My Rides
                                </a>
                            </li>
                        }
                    }

                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Driver" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Drivers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Complaints" asp-action="MyTickets">
                                <i class="bi bi-ticket me-1"></i>My Tickets
                            </a>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield me-1"></i>Admins
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Complaints" asp-action="Index">
                                <i class="bi bi-flag me-1"></i>Complaints
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity.IsAuthenticated == false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sk-primary btn-sm" asp-controller="Account" asp-action="Register">
                                Get started
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-user-pill nav-link">
                                <span class="avatar-dot">@(User.Identity?.Name?.Substring(0,1).ToUpper())</span>
                                @User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Sign out
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <main class="sk-page">
        @RenderBody()
    </main>

    <footer class="sk-footer">
        <div class="container">
            &copy; 2026 Sekka — <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
