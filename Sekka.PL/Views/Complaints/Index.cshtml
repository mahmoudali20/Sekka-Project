@model IEnumerable<Sekka.BLL.ViewModels.ComplaintVM>
@using Sekka.DAL.Models
@{
    ViewData["Title"] = "All Complaints";
}

<h2 class="mb-4">All Complaints</h2>

@if (TempData["SuccessMessage"] is string succ)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @succ <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted">No complaints found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ticket #</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Complainant</th>
                    <th>Driver</th>
                    <th>Submitted</th>
                    <th>Assigned Agent</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var priClass = c.Priority switch
                    {
                        ComplaintPriority.Critical => "danger",
                        ComplaintPriority.High     => "warning",
                        ComplaintPriority.Medium   => "info",
                        _                          => "secondary"
                    };
                    var statusClass = c.Status switch
                    {
                        ComplaintStatus.Open      => "primary",
                        ComplaintStatus.InReview  => "info",
                        ComplaintStatus.Escalated => "warning",
                        ComplaintStatus.Resolved  => "success",
                        ComplaintStatus.Closed    => "secondary",
                        _                         => "secondary"
                    };

                    <tr>
                        <td><code>@c.TicketReference</code></td>
                        <td>@c.Category</td>
                        <td><span class="badge bg-@priClass">@c.Priority</span></td>
                        <td><span class="badge bg-@statusClass">@c.Status</span></td>

                        @* Complainant (passenger) *@
                        <td>
                            @if (c.ComplainantName is not null)
                            {
                                <span>@c.ComplainantName</span>
                            }
                            else
                            {
                                <span class="text-muted small">@c.ComplainantId</span>
                            }
                        </td>

                        @* Driver (only meaningful when a trip is linked) *@
                        <td>
                            @if (c.DriverName is not null)
                            {
                                <span>@c.DriverName</span>
                            }
                            else if (c.TripId.HasValue)
                            {
                                <span class="text-muted small">Trip #@c.TripId</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>@c.CreatedAt.ToString("dd MMM yyyy")</td>

                        @* Assigned agent *@
                        <td>
                            @if (c.AssignedAgentName is not null)
                            {
                                <span class="text-success">&#10003; @c.AssignedAgentName</span>
                            }
                            else
                            {
                                <span class="text-muted">Unassigned</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id"
                               class="btn btn-sm btn-outline-secondary me-1">Details</a>
                            <a asp-action="Assign" asp-route-id="@c.Id"
                               class="btn btn-sm btn-outline-primary">
                                @(c.AssignedAgentId != null ? "Reassign" : "Assign")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
