@model IEnumerable<Sekka.BLL.ViewModels.ComplaintVM>
@{
    ViewData["Title"] = "All Complaints";
}

<h2 class="mb-4">All Complaints</h2>

@if (TempData["SuccessMessage"] is string succ)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @succ <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted">No complaints found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ticket #</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Trip ID</th>
                    <th>Submitted</th>
                    <th>Assigned Agent</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><code>@c.TicketReference</code></td>
                        <td>@c.Category</td>
                        <td>
                            @{
                                var priClass = c.Priority switch
                                {
                                    Sekka.DAL.Models.ComplaintPriority.Critical => "danger",
                                    Sekka.DAL.Models.ComplaintPriority.High     => "warning",
                                    Sekka.DAL.Models.ComplaintPriority.Medium   => "info",
                                    _                                            => "secondary"
                                };
                            }
                            <span class="badge bg-@priClass">@c.Priority</span>
                        </td>
                        <td>
                            @{
                                var statusClass = c.Status switch
                                {
                                    Sekka.DAL.Models.ComplaintStatus.Open       => "primary",
                                    Sekka.DAL.Models.ComplaintStatus.InReview   => "info",
                                    Sekka.DAL.Models.ComplaintStatus.Escalated  => "warning",
                                    Sekka.DAL.Models.ComplaintStatus.Resolved   => "success",
                                    Sekka.DAL.Models.ComplaintStatus.Closed     => "secondary",
                                    _                                            => "secondary"
                                };
                            }
                            <span class="badge bg-@statusClass">@c.Status</span>
                        </td>
                        <td>@(c.TripId?.ToString() ?? "—")</td>
                        <td>@c.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (c.AssignedAgentId!=null)
                            {
                                <span class="text-success">&#10003; Assigned</span>
                            }
                            else
                            {
                                <span class="text-muted">Unassigned</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Assign" asp-route-id="@c.Id"
                               class="btn btn-sm btn-outline-primary">
                                @(c.AssignedAgentId!=null ? "Reassign" : "Assign")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
