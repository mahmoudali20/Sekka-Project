@model Sekka.BLL.ViewModels.ComplaintVM
@using Sekka.DAL.Models
@{
    ViewData["Title"] = "Assign Ticket";
    var adminList = ViewBag.AdminList as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                    ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <h2 class="mb-1">Assign Ticket</h2>
        <p class="text-muted mb-4">
            Ticket <code>@Model.TicketReference</code> &mdash; @Model.Category
        </p>

        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header fw-semibold">Complaint Summary</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Subject</dt>
                    <dd class="col-sm-8">@Model.Subject</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Priority</dt>
                    <dd class="col-sm-8">@Model.Priority</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    @* ── Complainant ── *@
                    <dt class="col-sm-4">Submitted By</dt>
                    <dd class="col-sm-8">
                        @(Model.ComplainantName ?? Model.ComplainantId)
                    </dd>

                    @* ── Driver ── *@
                    @if (Model.DriverName is not null)
                    {
                        <dt class="col-sm-4">Driver</dt>
                        <dd class="col-sm-8">@Model.DriverName</dd>
                    }
                    else if (Model.TripId.HasValue)
                    {
                        <dt class="col-sm-4">Trip</dt>
                        <dd class="col-sm-8">#@Model.TripId</dd>
                    }

                    @* ── Current agent ── *@
                    @if (Model.AssignedAgentName is not null)
                    {
                        <dt class="col-sm-4">Currently Assigned</dt>
                        <dd class="col-sm-8 text-success">@Model.AssignedAgentName</dd>
                    }

                    <dt class="col-sm-4">Submitted</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <form method="post" asp-action="Assign">
            @Html.AntiForgeryToken()
            <input type="hidden" name="complaintId" value="@Model.Id" />

            <div class="mb-3">
                <label for="adminId" class="form-label fw-semibold">Select Admin</label>
                @if (!adminList.Any())
                {
                    <p class="text-danger">No admins available. Please create an admin account first.</p>
                }
                else
                {
                    <select id="adminId" name="adminId" class="form-select" required>
                        <option value="">— choose an admin —</option>
                        @foreach (var item in adminList)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" @(!adminList.Any() ? "disabled" : "")>
                    Assign Ticket
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>

    </div>
</div>
