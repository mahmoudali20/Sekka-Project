@using Sekka.DAL.Models
@using System.Security.Claims

@model IEnumerable<Sekka.DAL.Models.Ride>

@{
    ViewData["Title"] = "Dashboard";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isPassenger   = User.IsInRole("Passenger");
    var isDriver      = User.IsInRole("Driver");
}

<!-- Toast container -->
<div id="notificationContainer" class="position-fixed top-0 end-0 p-3" style="z-index:9999;margin-top:70px;"></div>

<div class="container">

    @Html.AntiForgeryToken()

    <!-- Server alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="serverError" class="sk-alert sk-alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="serverSuccess" class="sk-alert sk-alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- PASSENGER DASHBOARD                                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (isPassenger)
    {
        var myRides = Model
            .Where(r => r.PassengerId == currentUserId)
            .OrderByDescending(r => r.RequestTime)
            .ToList();

        var activeRide = myRides.FirstOrDefault(r =>
            r.Status != RideStatus.Completed && r.Status != RideStatus.Cancelled);

        var unratedRide = myRides.FirstOrDefault(r =>
            r.Status == RideStatus.Completed && r.Rating == null);

        <!-- Header -->
        <div class="sk-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1>My dashboard</h1>
                <p class="subtitle">Track your current ride and recent trips.</p>
            </div>
            @if (activeRide == null && unratedRide == null)
            {
                <a asp-action="Book" class="btn btn-sk-primary">
                    <i class="bi bi-car-front-fill me-2"></i>Book a ride
                </a>
            }
        </div>

        <!-- ── ACTIVE RIDE ── -->
        @if (activeRide != null)
        {
            <div class="sk-active-ride mb-4 p-0 overflow-hidden" data-ride-id="@activeRide.RideID" id="passengerRideCard">

                <div class="sk-card-header amber" style="border-radius:var(--sk-radius) var(--sk-radius) 0 0;">
                    <span class="pulse-dot"></span>
                    Active ride &nbsp;·&nbsp;
                    <span class="ride-status fw-700">@activeRide.Status</span>
                </div>

                <div class="sk-card-body">
                    <div class="row g-4">

                        <!-- Route -->
                        <div class="col-md-5">
                            <div class="sk-ride-card border-0 shadow-none p-0" style="border-left:none;">
                                <div class="route-line">
                                    <div class="d-flex align-items-start gap-2 position-relative">
                                        <span class="route-dot pickup" style="position:relative;top:4px;flex-shrink:0;"></span>
                                        <div>
                                            <div style="font-size:.72rem;color:var(--sk-text-muted);">Pickup</div>
                                            <div class="fw-600">@activeRide.PickupLocation</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-2 mt-3 position-relative">
                                        <span class="route-dot dropoff" style="position:relative;top:4px;flex-shrink:0;"></span>
                                        <div>
                                            <div style="font-size:.72rem;color:var(--sk-text-muted);">Destination</div>
                                            <div class="fw-600">@activeRide.DropoffLocation</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-4">
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Distance</div>
                                    <div class="fw-700">@activeRide.DistanceInKm km</div>
                                </div>
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Fare</div>
                                    <div class="sk-fare" style="font-size:1.2rem;">@activeRide.EstimatedFare <span>EGP</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Driver info -->
                        <div class="col-md-4">
                            <div class="driver-info">
                                @if (activeRide.DriverId.HasValue && activeRide.Driver != null)
                                {
                                    <div class="sk-driver-box">
                                        <div class="sk-driver-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="driver-name">@(activeRide.Driver.User?.FullName ?? "Captain")</div>
                                            <div class="driver-meta">
                                                <i class="bi bi-star-fill me-1"></i>
                                                @(activeRide.Driver.RatingAverage.ToString("0.00")) / 5
                                            </div>
                                            <div class="driver-meta">
                                                <i class="bi bi-telephone-fill me-1"></i>@(activeRide.Driver.User?.PhoneNumber ?? "N/A")
                                            </div>
                                            @if (activeRide.Driver.Car != null)
                                            {
                                                <div class="driver-meta mt-1">
                                                    <i class="bi bi-car-front me-1"></i>
                                                    @activeRide.Driver.Car.Color @activeRide.Driver.Car.Model
                                                    &nbsp;·&nbsp; @activeRide.Driver.Car.PlateNumber
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="sk-driver-box">
                                        <div class="sk-driver-avatar" style="background:rgba(245,166,35,.15);">
                                            <i class="bi bi-hourglass-split" style="color:var(--sk-amber);font-size:1.1rem;"></i>
                                        </div>
                                        <div>
                                            <div class="driver-name">Finding your captain…</div>
                                            <div class="driver-meta">This usually takes under a minute.</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Cancel -->
                        <div class="col-md-3 d-flex align-items-center justify-content-md-end">
                            @if (activeRide.Status == RideStatus.Requested || activeRide.Status == RideStatus.Accepted)
                            {
                                <form asp-action="Cancel" method="post" id="cancelRideForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rideId"  value="@activeRide.RideID" />
                                    <input type="hidden" name="reason"  value="Changed my mind" />
                                    <button type="submit" class="btn btn-sk-outline-danger">
                                        <i class="bi bi-x-circle me-1"></i>Cancel ride
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }

        <!-- ── RATE LAST TRIP ── -->
        @if (activeRide == null && unratedRide != null)
        {
            <div class="sk-card mb-4" style="border:2px solid var(--sk-amber);">
                <div class="sk-card-header amber">
                    <i class="bi bi-star-fill"></i> Rate your last trip
                </div>
                <div class="sk-card-body text-center py-4">
                    <p class="mb-3">
                        How was your ride with
                        <strong>@(unratedRide.Driver?.User?.FullName ?? "your captain")</strong>?
                    </p>
                    <form asp-action="Rate" method="post" class="d-inline-block">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RideId" value="@unratedRide.RideID" />
                        <div class="sk-stars mb-3" id="starRater">
                            @for (int s = 5; s >= 1; s--)
                            {
                                <label data-value="@s" style="cursor:pointer;">★</label>
                            }
                        </div>
                        <input type="hidden" name="Score" id="ratingScore" value="0" />
                        <div class="sk-input-group justify-content-center mb-3" style="max-width:420px;margin:0 auto;">
                            <input type="text" name="Comment" class="sk-form-control"
                                   placeholder="Add a comment (optional)…" />
                            <button type="submit" class="btn btn-sk-primary px-4" id="submitRateBtn" disabled>
                                Submit
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- ── EMPTY STATE ── -->
        @if (activeRide == null && unratedRide == null)
        {
            <div class="sk-empty">
                <span class="icon"><i class="bi bi-car-front"></i></span>
                <h4 class="fw-700" style="color:var(--sk-navy);">No active rides</h4>
                <p>Ready to go somewhere?</p>
                <a asp-action="Book" class="btn btn-sk-primary px-4">Book a ride now</a>
            </div>
        }
    }


    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- DRIVER DASHBOARD                                        -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (isDriver)
    {
        var myActiveRide = Model.FirstOrDefault(r =>
            r.Driver?.UserId == currentUserId &&
            r.Status != RideStatus.Completed &&
            r.Status != RideStatus.Cancelled);

        var availableRequests = Model
            .Where(r => r.Status == RideStatus.Requested)
            .OrderByDescending(r => r.RequestTime)
            .ToList();

        <!-- Header -->
        <div class="sk-page-header">
            <h1>Driver dashboard</h1>
            <p class="subtitle">
                @if (myActiveRide != null)
                {
                    <span>You have an active trip in progress.</span>
                }
                else
                {
                    <span>@availableRequests.Count ride request(s) waiting for a driver.</span>
                }
            </p>
        </div>

        <!-- ── ACTIVE TRIP ── -->
        @if (myActiveRide != null)
        {
            <div class="sk-active-ride mb-4 p-0 overflow-hidden" data-ride-id="@myActiveRide.RideID" id="driverActiveRideCard">
                <div class="sk-card-header green" style="border-radius:var(--sk-radius) var(--sk-radius) 0 0;">
                    <span class="pulse-dot" style="background:var(--sk-green);"></span>
                    Current trip &nbsp;·&nbsp;
                    <span class="ride-status fw-700">@myActiveRide.Status</span>
                </div>

                <div class="sk-card-body">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-5">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="sk-driver-avatar" style="width:40px;height:40px;font-size:1rem;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Passenger</div>
                                    <div class="fw-700">@(myActiveRide.Passenger?.FullName ?? "Passenger")</div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mb-1">
                                <span class="route-dot pickup" style="margin-top:4px;flex-shrink:0;position:relative;"></span>
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Pickup</div>
                                    <div class="fw-600" style="font-size:.9rem;">@myActiveRide.PickupLocation</div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <span class="route-dot dropoff" style="margin-top:4px;flex-shrink:0;position:relative;"></span>
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Destination</div>
                                    <div class="fw-600" style="font-size:.9rem;">@myActiveRide.DropoffLocation</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="d-flex gap-4">
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Distance</div>
                                    <div class="fw-700">@myActiveRide.DistanceInKm km</div>
                                </div>
                                <div>
                                    <div style="font-size:.72rem;color:var(--sk-text-muted);">Fare</div>
                                    <div class="sk-fare" style="font-size:1.2rem;">@myActiveRide.EstimatedFare <span>EGP</span></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex justify-content-md-end gap-2">
                            @if (myActiveRide.Status == RideStatus.Accepted)
                            {
                                <form asp-action="Start" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rideId" value="@myActiveRide.RideID" />
                                    <button type="submit" class="btn btn-sk-primary">
                                        <i class="bi bi-geo-fill me-1"></i>Start ride
                                    </button>
                                </form>
                            }
                            else if (myActiveRide.Status == RideStatus.Started)
                            {
                                <form asp-action="Complete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rideId"      value="@myActiveRide.RideID" />
                                    <input type="hidden" name="actualFare"  value="@myActiveRide.EstimatedFare" />
                                    <button type="submit" class="btn btn-sk-success">
                                        <i class="bi bi-check2-all me-1"></i>Complete ride
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ── AVAILABLE REQUESTS ── -->
        @if (myActiveRide == null)
        {
            <h5 class="fw-700 mb-3" style="color:var(--sk-text-muted);">Available requests</h5>

            <div class="row g-3" id="availableRidesContainer">
                @if (!availableRequests.Any())
                {
                    <div class="col-12" id="noRequestsMessage">
                        <div class="sk-empty" style="padding:3rem 1rem;">
                            <span class="icon"><i class="bi bi-inbox"></i></span>
                            <p>No ride requests right now. Check back in a moment.</p>
                        </div>
                    </div>
                }

                @foreach (var req in availableRequests)
                {
                    <div class="col-md-6 col-xl-4" data-ride-id="@req.RideID">
                        <div class="sk-card sk-ride-card h-100">
                            <div class="sk-card-body">

                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="sk-fare" style="font-size:1.3rem;">
                                        @req.EstimatedFare <span>EGP</span>
                                    </div>
                                    <span class="sk-badge sk-badge-requested">@req.DistanceInKm km</span>
                                </div>

                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <div class="sk-driver-avatar" style="width:34px;height:34px;font-size:.85rem;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="fw-600" style="font-size:.9rem;">
                                        @(req.Passenger?.FullName ?? "Passenger")
                                    </div>
                                </div>

                                <div class="route-line mb-3">
                                    <div class="d-flex gap-2 align-items-start position-relative">
                                        <span class="route-dot pickup" style="position:relative;top:3px;flex-shrink:0;"></span>
                                        <div style="font-size:.83rem;">@req.PickupLocation</div>
                                    </div>
                                    <div class="d-flex gap-2 align-items-start mt-2 position-relative">
                                        <span class="route-dot dropoff" style="position:relative;top:3px;flex-shrink:0;"></span>
                                        <div style="font-size:.83rem;">@req.DropoffLocation</div>
                                    </div>
                                </div>

                                <form asp-action="Accept" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rideId" value="@req.RideID" />
                                    <button type="submit" class="btn btn-sk-success w-100">
                                        <i class="bi bi-check2-circle me-1"></i>Accept
                                    </button>
                                </form>
                            </div>

                            <div class="sk-card-footer">
                                <i class="bi bi-clock me-1"></i>
                                Requested at @req.RequestTime.ToLocalTime().ToString("hh:mm tt")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

</div>

<!-- SignalR -->
@if (isDriver || isPassenger)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/tripHub.js" asp-append-version="true"></script>
}

@section Scripts {
<script>
    // Auto-dismiss server alerts
    setTimeout(() => {
        document.getElementById("serverError")?.remove();
        document.getElementById("serverSuccess")?.remove();
    }, 4000);

    // Star rater for passenger rating
    const starLabels = document.querySelectorAll('#starRater label');
    const scoreInput = document.getElementById('ratingScore');
    const submitBtn  = document.getElementById('submitRateBtn');

    if (starLabels.length) {
        starLabels.forEach(lbl => {
            lbl.addEventListener('click', () => {
                const v = parseInt(lbl.dataset.value);
                scoreInput.value = v;
                if (submitBtn) submitBtn.disabled = false;
                starLabels.forEach(l =>
                    l.style.color = parseInt(l.dataset.value) <= v ? 'var(--sk-amber)' : '#D1D5DB'
                );
            });
            lbl.addEventListener('mouseenter', () => {
                const v = parseInt(lbl.dataset.value);
                starLabels.forEach(l =>
                    l.style.color = parseInt(l.dataset.value) <= v ? 'var(--sk-amber)' : '#D1D5DB'
                );
            });
        });
        document.getElementById('starRater')?.addEventListener('mouseleave', () => {
            const current = parseInt(scoreInput?.value || 0);
            starLabels.forEach(l =>
                l.style.color = parseInt(l.dataset.value) <= current ? 'var(--sk-amber)' : '#D1D5DB'
            );
        });
    }
</script>
}
