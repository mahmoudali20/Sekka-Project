@model Sekka.BLL.ViewModels.TripVM.BookRideVM

@{
    ViewData["Title"] = "Book a Ride";
}

@section HeadLinks {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="container">

    <!-- Page Header -->
    <div class="sk-page-header">
        <h1>Book a ride</h1>
        <p class="subtitle">Set your pickup and destination — we'll find you a driver.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="sk-alert sk-alert-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-4 align-items-start">

        <!-- ── Booking Form ── -->
        <div class="col-lg-4">
            <div class="sk-card">
                <div class="sk-card-header navy">
                    <i class="bi bi-car-front-fill"></i>
                    Ride details
                </div>
                <div class="sk-card-body">

                    <form asp-action="Book" method="post" id="bookingForm">

                        <input type="hidden" asp-for="PickupLat"    id="PickupLat" />
                        <input type="hidden" asp-for="PickupLng"    id="PickupLng" />
                        <input type="hidden" asp-for="DropoffLat"   id="DropoffLat" />
                        <input type="hidden" asp-for="DropoffLng"   id="DropoffLng" />
                        <input type="hidden" asp-for="DistanceInKm" id="DistanceInKm" />

                        <!-- Pickup -->
                        <div class="sk-form-group">
                            <label class="sk-form-label">
                                <span style="color:var(--sk-green);">●</span> Pickup location
                            </label>
                            <div class="sk-input-group">
                                <input asp-for="PickupLocation" id="PickupLocation"
                                       class="sk-form-control" placeholder="Locating you…" readonly />
                                <button type="button" class="btn btn-sk-navy px-3" onclick="locateUser()" title="Use GPS">
                                    <i class="bi bi-crosshair"></i>
                                </button>
                            </div>
                            <div style="font-size:.78rem;color:var(--sk-text-muted);margin-top:.4rem;">
                                Drag the blue pin on the map to fine-tune.
                            </div>
                            <span asp-validation-for="PickupLocation" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <!-- Dropoff -->
                        <div class="sk-form-group">
                            <label class="sk-form-label">
                                <span style="color:var(--sk-red);">●</span> Destination
                            </label>
                            <div class="sk-input-group">
                                <input asp-for="DropoffLocation" id="DropoffLocation"
                                       class="sk-form-control" placeholder="e.g. Cairo University" />
                                <button type="button" class="btn btn-sk-primary px-3" onclick="searchDropoff()">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <span asp-validation-for="DropoffLocation" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <hr class="divider" />

                        <!-- Payment method -->
                        <div class="sk-form-group">
                            <label class="sk-form-label">
                                <i class="bi bi-credit-card"></i> How will you pay?
                            </label>
                            <select asp-for="PreferredPaymentMethod" class="sk-form-control"
                                    asp-items="Html.GetEnumSelectList<Sekka.DAL.Models.PaymentMethod>()">
                            </select>
                            <div style="font-size:.78rem;color:var(--sk-text-muted);margin-top:.4rem;">
                                Charged once the ride is done — you can still change it on the payment screen.
                            </div>
                            <span asp-validation-for="PreferredPaymentMethod" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <hr class="divider" />

                        <!-- Fare estimate -->
                        <div class="sk-form-group">
                            <label class="sk-form-label">Estimated fare</label>
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <div class="sk-fare">
                                        <span id="fareDisplay">—</span>
                                        <span>EGP</span>
                                    </div>
                                    <div id="distanceText" style="font-size:.8rem;color:var(--sk-text-muted);margin-top:.2rem;"></div>
                                </div>
                            </div>
                            <input asp-for="EstimatedFare" id="EstimatedFare" type="hidden" />
                        </div>

                        <button type="submit" class="btn btn-sk-primary w-100 btn-lg" id="submitBtn" disabled>
                            <i class="bi bi-car-front-fill me-2"></i>Request ride
                        </button>

                    </form>

                </div>
            </div>
        </div>

        <!-- ── Map ── -->
        <div class="col-lg-8">
            <div class="sk-map-wrap" style="height:520px;">
                <div id="map" style="height:100%;width:100%;"></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([30.0444, 31.2357], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var pickupMarker, dropoffMarker, routeLine;

        var redIcon = new L.Icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });

        function locateUser() {
            if (!navigator.geolocation) return;
            document.getElementById('PickupLocation').value = 'Locating with high accuracy…';
            navigator.geolocation.getCurrentPosition(function(pos) {
                setPickup(pos.coords.latitude, pos.coords.longitude);
                map.setView([pos.coords.latitude, pos.coords.longitude], 16);
            }, function(error) {
                document.getElementById('PickupLocation').value = '';
                alert('Please allow location access, or select your location manually on the map.');
            }, { enableHighAccuracy: true });
        }

        locateUser();

        function setPickup(lat, lng) {
            if (pickupMarker) map.removeLayer(pickupMarker);
            pickupMarker = L.marker([lat, lng], { draggable: true }).addTo(map).bindPopup('Pickup').openPopup();
            updatePickupData(lat, lng);

            pickupMarker.on('dragend', function() {
                var p = pickupMarker.getLatLng();
                updatePickupData(p.lat, p.lng);
            });
        }

        function updatePickupData(lat, lng) {
            document.getElementById('PickupLat').value = lat;
            document.getElementById('PickupLng').value = lng;
            document.getElementById('PickupLocation').value = 'Loading address...';

            fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng)
                .then(r => r.json()).then(d => {
                    document.getElementById('PickupLocation').value = d.display_name.split(',').slice(0, 3).join(',');
                    calculateFare();
                });
        }


        map.on('click', function(e) {
            setDropoff(e.latlng.lat, e.latlng.lng);
        });

        function setDropoff(lat, lng) {
            if (dropoffMarker) {
                dropoffMarker.setLatLng([lat, lng]);
                dropoffMarker.openPopup();
            } else {
                dropoffMarker = L.marker([lat, lng], { icon: redIcon, draggable: true }).addTo(map).bindPopup('Destination').openPopup();

                dropoffMarker.on('dragend', function() {
                    var p = dropoffMarker.getLatLng();
                    updateDropoffData(p.lat, p.lng);
                });
            }
            updateDropoffData(lat, lng);
        }

        function updateDropoffData(lat, lng) {
            document.getElementById('DropoffLat').value = lat;
            document.getElementById('DropoffLng').value = lng;
            document.getElementById('DropoffLocation').value = 'Loading address...';

            fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng)
                .then(r => r.json()).then(d => {
                    if (d.display_name) {
                        document.getElementById('DropoffLocation').value = d.display_name.split(',').slice(0, 3).join(',');
                    } else {
                        document.getElementById('DropoffLocation').value = 'Selected on map';
                    }
                    calculateFare();
                });
        }

        function searchDropoff() {
            var q = document.getElementById('DropoffLocation').value;
            if (!q) return;
            fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(q + ', Egypt') + '&limit=1')
                .then(r => r.json()).then(data => {
                    if (!data.length) { alert('Location not found. Try dropping a pin on the map instead.'); return; }
                    setDropoff(parseFloat(data[0].lat), parseFloat(data[0].lon));
                });
        }

        function getDistanceFromLatLonInKm(lat1, lon1, lat2, lon2) {
            var R = 6371;
            var dLat = (lat2 - lat1) * (Math.PI / 180);
            var dLon = (lon2 - lon1) * (Math.PI / 180);
            var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * (Math.PI / 180)) * Math.cos(lat2 * (Math.PI / 180)) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
            var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        function calculateFare() {
            var pLat = parseFloat(document.getElementById('PickupLat').value);
            var pLng = parseFloat(document.getElementById('PickupLng').value);
            var dLat = parseFloat(document.getElementById('DropoffLat').value);
            var dLng = parseFloat(document.getElementById('DropoffLng').value);

            if (!pLat || !pLng || !dLat || !dLng) return;

            var straightDistance = getDistanceFromLatLonInKm(pLat, pLng, dLat, dLng);
            var realisticKm = (straightDistance * 1.15).toFixed(2);

            document.getElementById('DistanceInKm').value = realisticKm;
            document.getElementById('distanceText').textContent = realisticKm + ' km';

            var fare = Math.ceil(15 + realisticKm * 8);

            document.getElementById('EstimatedFare').value = fare;
            document.getElementById('fareDisplay').textContent = fare;
            document.getElementById('submitBtn').disabled = false;

            var url = `https://router.project-osrm.org/route/v1/driving/${pLng},${pLat};${dLng},${dLat}?overview=full&geometries=geojson`;

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (!data.routes || !data.routes.length) return;

                    if (routeLine) {
                        map.removeLayer(routeLine);
                    }

                    var coords = data.routes[0].geometry.coordinates;
                    var latLngs = coords.map(c => [c[1], c[0]]);

                    routeLine = L.polyline(latLngs, { color: '#0d6efd', weight: 5, opacity: 0.8 }).addTo(map);
                    map.fitBounds(routeLine.getBounds(), { padding: [30, 30] });
                })
                .catch(e => console.log("Routing Visualizer Error:", e));
        }
    </script>
}