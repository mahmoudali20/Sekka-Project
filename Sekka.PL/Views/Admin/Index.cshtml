@model IEnumerable<AdminVM>

@{
    ViewData["Title"] = "Admins";
}

<div class="sk-page">
    <div class="container">

        <div class="sk-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 style="font-size:1.75rem;">Admin Management</h1>
                <p class="subtitle">Manage platform administrator accounts</p>
            </div>
            <a asp-action="Create" class="btn btn-sk-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Add Admin
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="sk-alert sk-alert-success auto-dismiss" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="sk-alert sk-alert-danger auto-dismiss" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="sk-card">
            <div class="sk-card-header navy">
                <i class="bi bi-shield-lock-fill text-amber"></i>
                Administrators
                @{
                    var count = Model?.Count() ?? 0;
                }
                <span class="badge ms-auto" style="background:rgba(255,255,255,.15);font-weight:600;font-size:.75rem;padding:.3rem .7rem;border-radius:50px;">@count</span>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="sk-table">
                        <thead>
                            <tr>
                                <th>Admin</th>
                                <th>Username</th>
                                <th>Phone</th>
                                <th>Address</th>
                                <th class="text-center" style="width:90px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var admin in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-dot" style="width:36px;height:36px;border-radius:50%;background:var(--sk-navy-3);color:var(--sk-amber);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;">
                                                @(admin.FullName?.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div style="font-weight:600;color:var(--sk-text);">@admin.FullName</div>
                                                <div style="font-size:.8rem;color:var(--sk-text-muted);">@admin.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-family:monospace;background:var(--sk-surface-2);padding:.2rem .55rem;border-radius:6px;font-size:.85rem;color:var(--sk-text-muted);">
                                            @admin.UserName
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(admin.PhoneNumber) ? "—" : admin.PhoneNumber)</td>
                                    <td>@(string.IsNullOrEmpty(admin.Address) ? "—" : admin.Address)</td>
                                    <td class="text-center">
                                        <form asp-action="Delete" asp-route-id="@admin.Id" method="post"
                                              onsubmit="return confirm('Delete @admin.FullName? This cannot be undone.');"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sk-danger btn-sm d-inline-flex align-items-center gap-1" style="font-size:.8rem;padding:.35rem .75rem;">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="sk-empty">
                    <span class="icon"><i class="bi bi-shield-x"></i></span>
                    <h6 style="font-weight:700;color:var(--sk-text);">No admins yet</h6>
                    <p>Add the first admin account to get started.</p>
                    <a asp-action="Create" class="btn btn-sk-primary">
                        <i class="bi bi-plus-lg me-1"></i> Add Admin
                    </a>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        setTimeout(() => {
            document.querySelectorAll('.auto-dismiss').forEach(el => {
                el.style.transition = 'opacity .3s';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            });
        }, 3500);
    </script>
}
