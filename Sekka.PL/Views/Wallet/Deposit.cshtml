@model Sekka.BLL.ViewModels.WalletVM.DepositVM

@{
    ViewData["Title"] = "Deposit";
}

<div class="container">

    <div class="sk-page-header">
        <h1>Deposit into wallet</h1>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="sk-card">
                <div class="sk-card-header navy">
                    <i class="bi bi-cash-coin"></i> Amount
                </div>
                <div class="sk-card-body">
                    <form asp-action="Deposit" method="post">
                        @Html.AntiForgeryToken()

                        <div class="sk-form-group">
                            <label class="sk-form-label" asp-for="Amount"></label>
                            <input asp-for="Amount" class="sk-form-control" type="number" step="0.01" min="1" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="sk-form-group">
                            <label class="sk-form-label" asp-for="Description"></label>
                            <input asp-for="Description" class="sk-form-control" placeholder="Optional note" />
                        </div>

                        <button type="submit" class="btn btn-sk-navy w-100 mt-2">Deposit</button>
                        <a asp-action="Index" class="btn btn-link w-100 mt-2">Back to wallet</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
