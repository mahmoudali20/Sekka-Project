@using Sekka.BLL.ViewModels.WalletVM
@model IEnumerable<WalletTransactionVM>

@{
    ViewData["Title"] = "My Wallet";
    var balance = (WalletBalanceVM)ViewBag.Balance;
}

<div class="container">

    <div class="sk-page-header">
        <h1>My wallet</h1>
        <p class="subtitle">Deposit funds and pay for rides straight from your balance.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="sk-alert sk-alert-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="sk-alert sk-alert-success mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="sk-card mb-4">
        <div class="sk-card-header navy">
            <i class="bi bi-wallet2"></i> Balance
        </div>
        <div class="sk-card-body d-flex justify-content-between align-items-center">
            <h2 class="mb-0">@balance.Balance.ToString("C")</h2>
            <a asp-action="Deposit" class="btn btn-sk-navy">
                <i class="bi bi-plus-circle"></i> Deposit
            </a>
        </div>
    </div>

    <div class="sk-card">
        <div class="sk-card-header navy">
            <i class="bi bi-list-ul"></i> Transaction history
        </div>
        <div class="sk-card-body">
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No transactions yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Balance after</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>@t.Type</td>
                                <td>@t.Amount.ToString("C")</td>
                                <td>@t.BalanceAfter.ToString("C")</td>
                                <td>@t.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>
